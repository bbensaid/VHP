# ──────────────────────────────────────────────
# HTR AI Brain — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# Groq LLM — subscriber + student tier (required)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic — advisory tier (optional; falls back to Groq if unset)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI embeddings (required)
OPENAI_API_KEY=your_openai_api_key_here

# Sanity CMS (required)
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token_here
SANITY_API_VERSION=2023-10-01

# Supabase — pgvector storage + JWT auth (required in production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase_dashboard
# Postgres connection for LlamaIndex vector store
# Get from: Supabase Dashboard > Settings > Database > Connection pooling
SUPABASE_DB_URL=postgresql://postgres.yourref:yourpass@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# CORS — set to your Vercel domain in production
FRONTEND_URL=http://localhost:3000

# Optional: protect /api/ingest from unauthorized calls
INGEST_SECRET=your_random_secret_here

# Optional: Sentry error monitoring
SENTRY_DSN=https://your-key@oXXXXX.ingest.sentry.io/XXXXXXX
ENVIRONMENT=production
