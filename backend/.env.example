# ── Google AI ──────────────────────────────────────────────────────────────────
# Required. Powers Gemini LLM (gemini-flash-lite-latest) and embeddings (text-embedding-004).
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── Sanity CMS ─────────────────────────────────────────────────────────────────
# Required for ingesting CMS content into the RAG index.
# Project ID: found in sanity.config.ts or https://sanity.io/manage
SANITY_PROJECT_ID=your_project_id_here

# Dataset (usually "production")
SANITY_DATASET=production

# API token: create a read-only token at https://sanity.io/manage → API → Tokens
SANITY_API_TOKEN=your_sanity_api_token_here

# API version (ISO date string — do not change unless you know why)
SANITY_API_VERSION=2023-10-01

# ── CORS ───────────────────────────────────────────────────────────────────────
# URL of your Next.js frontend. Adjust for production.
FRONTEND_URL=http://localhost:3000
