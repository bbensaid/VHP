# ============================================================
# HTR Backend — Railway Environment Variables
# ============================================================
# Set these in the Railway project dashboard under Variables.
# NEVER commit actual values.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Groq LLM ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Anthropic (Advisory tier) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Sanity CMS ───────────────────────────────────────────────
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=skukF0kFUFw7...

# ── App secrets ──────────────────────────────────────────────
INGEST_SECRET=generate-a-random-secret-here
FRONTEND_URL=https://your-domain.vercel.app

# ── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
ENVIRONMENT=production

# ── Performance ──────────────────────────────────────────────
# Railway: set PORT automatically — do not override
# WORKERS=2  # Uncomment on paid Railway plan for multi-worker Uvicorn
